@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Tài khoản";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}
<section class="min-h-[calc(100dvh-4rem)] bg-slate-100 px-4 py-10 sm:py-14" aria-labelledby="page-title">
    <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-[17rem_1fr]">
        <aside class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_50px_rgba(51,65,85,0.10)]">
            <div class="bg-emerald-800 px-6 py-7 text-center text-white">
                <span class="mx-auto flex size-20 items-center justify-center rounded-2xl border border-white/30 bg-white/15 text-3xl font-bold" aria-hidden="true">@displayName[..1].ToUpperInvariant()</span>
                <p class="mt-4 truncate text-lg font-bold">@displayName</p>
                <p class="mt-1 text-sm text-emerald-100">@role</p>
            </div>
            <nav class="p-3" aria-label="Cài đặt tài khoản">
                <a class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-emerald-700" asp-action="Profile"><span class="flex size-7 items-center justify-center rounded-md border border-slate-200" aria-hidden="true">●</span>Thông tin cá nhân</a>
                <a class="mt-1 flex items-center gap-3 rounded-lg bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" asp-action="ChangePassword" aria-current="page"><span class="flex size-7 items-center justify-center rounded-md border border-emerald-200" aria-hidden="true">◆</span>Bảo mật</a>
            </nav>
        </aside>

        <div class="rounded-2xl border border-slate-200 bg-white px-6 py-8 shadow-[0_18px_50px_rgba(51,65,85,0.10)] sm:px-9 sm:py-10">
            <nav class="mb-6 inline-flex gap-0.5 rounded-lg bg-slate-100 p-1" aria-label="Nội dung hồ sơ">
                <a class="rounded-md px-4 py-2 text-xs font-semibold text-slate-500 transition hover:text-slate-800 focus-visible:outline-2 focus-visible:outline-emerald-700" asp-action="Profile">Thông tin</a>
                <a class="rounded-md bg-white px-4 py-2 text-xs font-semibold text-slate-900 shadow-sm" asp-action="ChangePassword" aria-current="page">Bảo mật</a>
            </nav>
            <header class="border-b border-slate-200 pb-6">
                <p class="text-sm font-semibold text-emerald-700">Bảo mật tài khoản</p>
                <h1 id="page-title" class="mt-1 text-2xl font-bold tracking-tight text-slate-950">Đổi mật khẩu</h1>
                <p class="mt-2 text-sm leading-6 text-slate-500">Sau khi đổi, mọi phiên sẽ bị thu hồi và bạn cần đăng nhập lại.</p>
            </header>
            <form asp-action="ChangePassword" method="post" class="mt-7 space-y-5">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="space-y-2"><div class="flex items-center gap-1"><label asp-for="CurrentPassword"></label><span class="text-red-700" aria-hidden="true">*</span></div><input asp-for="CurrentPassword" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" required autofocus /><span asp-validation-for="CurrentPassword"></span></div>
                <div class="space-y-2"><div class="flex items-center gap-1"><label asp-for="NewPassword"></label><span class="text-red-700" aria-hidden="true">*</span></div><input asp-for="NewPassword" autocomplete="new-password" placeholder="Nhập mật khẩu mới" required aria-describedby="new-password-help" /><p id="new-password-help" class="text-sm text-slate-500">8–32 ký tự, gồm chữ và số; không có khoảng trắng.</p><span asp-validation-for="NewPassword"></span></div>
                <div class="space-y-2"><div class="flex items-center gap-1"><label asp-for="ConfirmNewPassword"></label><span class="text-red-700" aria-hidden="true">*</span></div><input asp-for="ConfirmNewPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" required /><span asp-validation-for="ConfirmNewPassword"></span></div>
                <div class="border-t border-slate-200 pt-6 text-right">
                    <button class="w-full rounded-lg bg-emerald-700 px-6 py-3 text-sm font-bold uppercase tracking-[0.1em] text-white transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 active:translate-y-px sm:w-auto" type="submit">Cập nhật mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
