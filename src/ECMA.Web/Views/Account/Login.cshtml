@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="flex min-h-[calc(100dvh-4rem)] items-center justify-center bg-slate-100 px-4 py-10" aria-labelledby="page-title">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white px-6 py-9 shadow-[0_18px_50px_rgba(51,65,85,0.12)] sm:px-9 sm:py-10">
        <h1 id="page-title" class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-950">Đăng nhập</h1>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <p class="mb-5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">@successMessage</p>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <p class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">@errorMessage</p>
        }
        <form asp-action="Login" method="post" class="space-y-5">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="space-y-2">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" placeholder="Nhập tên đăng nhập" required autofocus />
                <span asp-validation-for="Username"></span>
            </div>
            <div class="space-y-2">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                <span asp-validation-for="Password"></span>
            </div>
            <button class="w-full rounded-lg bg-emerald-700 px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 active:translate-y-px" type="submit">Đăng nhập</button>
        </form>
        <div class="my-4 flex items-center gap-3" aria-hidden="true">
            <span class="flex-1 border-t border-slate-200"></span>
            <span class="text-sm text-slate-400">Hoặc</span>
            <span class="flex-1 border-t border-slate-200"></span>
        </div>
        <p class="text-center text-sm text-slate-600">Chưa có tài khoản? <a class="font-bold text-emerald-600 underline-offset-4 hover:text-emerald-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
