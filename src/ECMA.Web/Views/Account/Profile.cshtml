@model ProfileViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? Model.Username : Model.FullName;
}
<section class="min-h-[calc(100dvh-4rem)] bg-slate-100 px-4 py-10 sm:py-14" aria-labelledby="page-title">
    <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-[17rem_1fr]">
        <aside class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_50px_rgba(51,65,85,0.10)]">
            <div class="bg-emerald-800 px-6 py-7 text-center text-white">
                <span class="mx-auto flex size-20 items-center justify-center rounded-2xl border border-white/30 bg-white/15 text-3xl font-bold" aria-hidden="true">@displayName[..1].ToUpperInvariant()</span>
                <p class="mt-4 truncate text-lg font-bold">@displayName</p>
                <p class="mt-1 text-sm text-emerald-100">@Model.Role</p>
            </div>
            <nav class="p-3" aria-label="Cài đặt tài khoản">
                <a class="flex items-center gap-3 rounded-lg bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" asp-action="Profile" aria-current="page">
                    <span class="flex size-7 items-center justify-center rounded-md border border-emerald-200" aria-hidden="true">●</span>
                    Thông tin cá nhân
                </a>
                <a class="mt-1 flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-emerald-700" asp-action="ChangePassword">
                    <span class="flex size-7 items-center justify-center rounded-md border border-slate-200" aria-hidden="true">◆</span>
                    Bảo mật
                </a>
            </nav>
        </aside>

        <div class="rounded-2xl border border-slate-200 bg-white px-6 py-8 shadow-[0_18px_50px_rgba(51,65,85,0.10)] sm:px-9 sm:py-10">
            <nav class="mb-6 inline-flex gap-0.5 rounded-lg bg-slate-100 p-1" aria-label="Nội dung hồ sơ">
                <a class="rounded-md bg-white px-4 py-2 text-xs font-semibold text-slate-900 shadow-sm" asp-action="Profile" aria-current="page">Thông tin</a>
                <a class="rounded-md px-4 py-2 text-xs font-semibold text-slate-500 transition hover:text-slate-800 focus-visible:outline-2 focus-visible:outline-emerald-700" asp-action="ChangePassword">Bảo mật</a>
            </nav>
            <header class="border-b border-slate-200 pb-6">
                <p class="text-sm font-semibold text-emerald-700">Hồ sơ cá nhân</p>
                <h1 id="page-title" class="mt-1 text-2xl font-bold tracking-tight text-slate-950">Thông tin tài khoản</h1>
                <p class="mt-2 text-sm leading-6 text-slate-500">Cập nhật tên hiển thị và xem thông tin đăng nhập của bạn.</p>
            </header>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <p class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">@successMessage</p>
            }

            <form asp-action="Profile" method="post" class="mt-7 space-y-6">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="grid gap-5 sm:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="Username"></label>
                        <input asp-for="Username" class="bg-slate-100 text-slate-500" disabled />
                        <p class="text-xs text-slate-500">Dùng để đăng nhập, không thể thay đổi.</p>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="Role"></label>
                        <input asp-for="Role" class="bg-slate-100 text-slate-500" disabled />
                        <p class="text-xs text-slate-500">Quyền truy cập hiện tại của tài khoản.</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <div class="flex items-center gap-1">
                        <label asp-for="FullName"></label>
                        <span class="text-red-700" aria-hidden="true">*</span>
                    </div>
                    <input asp-for="FullName" autocomplete="name" placeholder="Nhập họ và tên" required autofocus />
                    <span asp-validation-for="FullName"></span>
                </div>
                <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
                    <a class="text-center text-sm font-semibold text-emerald-700 underline-offset-4 hover:text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" asp-action="ChangePassword">Đổi mật khẩu</a>
                    <button class="rounded-lg bg-emerald-700 px-6 py-3 text-sm font-bold uppercase tracking-[0.1em] text-white transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 active:translate-y-px" type="submit">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
