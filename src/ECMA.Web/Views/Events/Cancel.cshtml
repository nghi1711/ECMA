@model CancelEventViewModel
@{ ViewData["Title"] = "Hủy sự kiện"; }
<div class="page-shell form-page"><a class="back-link" asp-action="Details" asp-route-id="@Model.EventId">Quay lại chi tiết</a><header class="page-heading"><h1>Hủy sự kiện</h1></header><form class="form-surface danger-surface" asp-action="Cancel" asp-route-id="@Model.EventId" method="post" data-confirm="Xác nhận hủy sự kiện? Mọi đăng ký còn hiệu lực cũng sẽ bị hủy."><input asp-for="EventId" type="hidden" /><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Reason">Lý do hủy <span aria-hidden="true">*</span></label><textarea asp-for="Reason" rows="6" maxlength="200" required></textarea><span class="field-hint">Lý do sẽ được lưu cùng sự kiện. Tối đa 200 ký tự.</span><span asp-validation-for="Reason"></span></div><div class="form-actions"><a class="button button-secondary" asp-action="Details" asp-route-id="@Model.EventId">Giữ sự kiện</a><button class="button button-danger" type="submit">Xác nhận hủy</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/event-confirmations.js" asp-append-version="true"></script> }