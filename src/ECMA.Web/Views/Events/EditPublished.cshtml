@model PublishedEventFormViewModel
@{ ViewData["Title"] = "Cập nhật sự kiện"; }
<div class="page-shell form-page">
<a class="back-link" asp-action="Details" asp-route-id="@Model.Id">Quay lại chi tiết</a>
<header class="page-heading"><h1>Cập nhật sự kiện</h1></header>
<form class="form-surface" asp-action="EditPublished" asp-route-id="@Model.Id" method="post">
<input asp-for="Id" type="hidden" /><input asp-for="OriginalLocation" type="hidden" />
<div asp-validation-summary="ModelOnly"></div>
<div class="form-grid">
<div class="field form-grid-full"><label asp-for="Title">Tiêu đề <span aria-hidden="true">*</span></label><input asp-for="Title" maxlength="100" required /><span asp-validation-for="Title"></span></div>
<div class="field form-grid-full"><label asp-for="Description">Mô tả <span aria-hidden="true">*</span></label><textarea asp-for="Description" rows="8" maxlength="3000" required></textarea><span asp-validation-for="Description"></span></div>
<div class="field form-grid-full" data-vietnam-location data-original-location="@Model.OriginalLocation">
<label asp-for="StreetAddress">Số nhà, tòa nhà, tên đường <span aria-hidden="true">*</span></label><input asp-for="StreetAddress" maxlength="200" required data-street-address /><span asp-validation-for="StreetAddress"></span>
<label asp-for="ProvinceCode">Tỉnh/thành <span aria-hidden="true">*</span></label><select asp-for="ProvinceCode" required data-province><option value="">Chọn tỉnh/thành</option>@foreach (var province in Model.Provinces) { <option value="@province.Code">@province.Name</option> }</select><span asp-validation-for="ProvinceCode"></span>
<label asp-for="WardCode">Xã/phường <span aria-hidden="true">*</span></label><select asp-for="WardCode" required data-ward><option value="">Chọn xã/phường</option>@foreach (var province in Model.Provinces) foreach (var ward in province.Wards) { <option value="@ward.Code" data-province-code="@province.Code">@ward.Name</option> }</select><span class="field-hint">Nếu thay đổi, hệ thống yêu cầu xác nhận trước khi gửi.</span><span asp-validation-for="WardCode"></span>
</div>
<div class="field"><label asp-for="Capacity">Sức chứa <span aria-hidden="true">*</span></label><input asp-for="Capacity" type="number" min="1" max="10000" required /><span class="field-hint">Không được giảm sức chứa hiện tại.</span><span asp-validation-for="Capacity"></span></div>
</div>
<div class="form-actions"><a class="button button-secondary" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="button button-primary" type="submit">Lưu thay đổi</button></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/event-location.js" asp-append-version="true"></script><script src="~/js/event-confirmations.js" asp-append-version="true"></script> }