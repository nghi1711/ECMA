@model EventFormViewModel
<div asp-validation-summary="ModelOnly"></div>
<div class="form-grid">
    <div class="field">
        <label asp-for="Type">Loại sự kiện <span aria-hidden="true">*</span></label>
        <select asp-for="Type" required>
            <option value="">Chọn loại</option>
            <option value="Event">Sự kiện</option>
            <option value="Conference">Hội nghị</option>
        </select>
        <span asp-validation-for="Type"></span>
    </div>
    <div class="field form-grid-wide">
        <label asp-for="Title">Tiêu đề <span aria-hidden="true">*</span></label>
        <input asp-for="Title" maxlength="100" autocomplete="off" required />
        <span asp-validation-for="Title"></span>
    </div>
    <div class="field form-grid-full">
        <label asp-for="Description">Mô tả <span aria-hidden="true">*</span></label>
        <textarea asp-for="Description" rows="8" maxlength="3000" required></textarea>
        <span class="field-hint">Tối đa 3.000 ký tự.</span>
        <span asp-validation-for="Description"></span>
    </div>
    <div class="field form-grid-full" data-vietnam-location>
        <label asp-for="StreetAddress">Số nhà, tòa nhà, tên đường <span aria-hidden="true">*</span></label>
        <input asp-for="StreetAddress" maxlength="200" autocomplete="street-address" required data-street-address />
        <span asp-validation-for="StreetAddress"></span>
        <label asp-for="ProvinceCode">Tỉnh/thành <span aria-hidden="true">*</span></label>
        <select asp-for="ProvinceCode" required data-province>
            <option value="">Chọn tỉnh/thành</option>
            @foreach (var province in Model.Provinces) { <option value="@province.Code">@province.Name</option> }
        </select>
        <span asp-validation-for="ProvinceCode"></span>
        <label asp-for="WardCode">Xã/phường <span aria-hidden="true">*</span></label>
        <select asp-for="WardCode" required data-ward>
            <option value="">Chọn xã/phường</option>
            @foreach (var province in Model.Provinces) foreach (var ward in province.Wards) { <option value="@ward.Code" data-province-code="@province.Code">@ward.Name</option> }
        </select>
        <span asp-validation-for="WardCode"></span>
    </div>
    <div class="field">
        <label asp-for="StartAt">Bắt đầu <span aria-hidden="true">*</span></label>
        <input asp-for="StartAt" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}" required />
        <span asp-validation-for="StartAt"></span>
    </div>
    <div class="field">
        <label asp-for="EndAt">Kết thúc <span aria-hidden="true">*</span></label>
        <input asp-for="EndAt" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}" required />
        <span asp-validation-for="EndAt"></span>
    </div>
    <div class="field">
        <label asp-for="Capacity">Sức chứa <span aria-hidden="true">*</span></label>
        <input asp-for="Capacity" type="number" min="1" max="10000" required />
        <span class="field-hint">Từ 1 đến 10.000 người.</span>
        <span asp-validation-for="Capacity"></span>
    </div>
</div>